+@app.get("/api/jobs/ranked", response_model=JobListResponse)
+async def ranked_jobs(
+    status: Optional[str] = Query(None),
+    source: Optional[str] = Query(None),
+    remote: Optional[bool] = Query(None),
+    min_score: int = Query(0, description="Minimum job_score (0-100)"),
+    limit: int = Query(50, le=200),
+    offset: int = Query(0),
+    session: AsyncSession = Depends(get_session),
+):
+    """Get jobs ranked by relevance score (highest first)."""
+    conditions = [Job.job_score >= min_score]
+
+    if status:
+        conditions.append(Job.status == status)
+    if source:
+        conditions.append(Job.source == source)
+    if remote is not None:
+        conditions.append(Job.remote == remote)
+
+    from sqlalchemy import and_
+    where = and_(*conditions) if conditions else True
+
+    count_stmt = select(func.count(Job.id)).where(where)
+    count_result = await session.execute(count_stmt)
+    total = count_result.scalar()
+
+    stmt = (
+        select(Job)
+        .where(where)
+        .order_by(Job.job_score.desc().nullslast(), Job.first_seen_at.desc())
+        .limit(limit)
+        .offset(offset)
+    )
+    result = await session.execute(stmt)
+    jobs = list(result.scalars().all())
+
+    return JobListResponse(
+        jobs=[JobResponse.model_validate(j) for j in jobs],
+        total=total, limit=limit, offset=offset,
+    )
+
+
 @app.get("/api/jobs/{job_id}", response_model=JobResponse)
 async def get_job(job_id: int, session: AsyncSession = Depends(get_session)):
     """Get a single job by ID."""
