# Pollen Job Crawler — Environment Variables
# Copy this to .env and fill in your values

# Database (leave empty to use SQLite)
DATABASE_URL=sqlite+aiosqlite:///jobs.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://pollen:password@localhost:5432/pollen

# Anthropic API key (required for company website scraping)
ANTHROPIC_API_KEY=sk-ant-...

# Slack alerts (optional)
SLACK_WEBHOOK_URL=

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
